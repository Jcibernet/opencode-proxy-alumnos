{
  // Configuracion de opencode para usar el proxy local CLIProxyAPI.
  // Instalar con: ./scripts/install-opencode-config.sh
  // Requiere que el proxy este corriendo: ./scripts/proxy-start.sh
  "$schema": "https://opencode.ai/config.json",

  // Default recomendado. Si no lo tienes disponible, usa /models y elige otro.
  "model": "cliproxy/gpt-5.5",
  "small_model": "cliproxy/claude-haiku-4-5-20251001",

  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1"
      },
      "models": {
        // --- OpenAI (GPT / Codex) via web login OAuth ---
        "gpt-5.5": {
          "name": "GPT-5.5",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        },

        // --- Anthropic (Claude) via web login OAuth ---
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        }
      }
    }
  }
}
