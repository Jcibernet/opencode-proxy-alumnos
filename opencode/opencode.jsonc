{
  // Configuracion de opencode para usar el proxy local CLIProxyAPI.
  // Instalala con: ./scripts/install-opencode-config.sh
  // Requiere que el proxy este corriendo (./scripts/proxy-start.sh).
  // Inicia sesion (OAuth) con Anthropic y/o OpenAI antes de usar (./scripts/login.sh).
  "$schema": "https://opencode.ai/config.json",

  // Modelo por defecto. Cambialo por el que prefieras de la lista de abajo.
  "model": "cliproxy/claude-sonnet-4-5-20250929",
  "small_model": "cliproxy/claude-haiku-4-5-20251001",

  "provider": {
    "cliproxy": {
      // Provider compatible con OpenAI. El proxy traduce a Claude / GPT.
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1"
      },
      "models": {
        // --- Anthropic (Claude) via login con Anthropic ---
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },
        "claude-sonnet-4-5-20250929": {
          "name": "Claude Sonnet 4.5",
          "tool_call": true,
          "limit": { "context": 200000, "output": 32000 }
        },

        // --- OpenAI (GPT / Codex) via login con OpenAI ---
        "gpt-5-codex": {
          "name": "GPT-5 Codex",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        },
        "gpt-5": {
          "name": "GPT-5",
          "tool_call": true,
          "limit": { "context": 256000, "output": 64000 }
        }
      }
    }
  }
}
